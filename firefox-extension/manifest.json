{
  "manifest_version": 3,
  "name": "Antigravity Life OS Companion",
  "version": "1.1.0",
  "description": "Premium browser tracking, auto LeetCode syncing, and distraction shields for the Antigravity Life OS.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "activeTab",
    "tabs",
    "alarms",
    "notifications",
    "webNavigation"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://localhost:5173/*",
    "https://frqrkkphddvxnsouhkfr.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["dashboard-content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
